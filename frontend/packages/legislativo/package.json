{
  "name": "@portalbrasil/legislativo",
  "version": "4.0.0-alpha.3",
  "description": "Portal Modelo: Ferramenta de portais para casas do legislativo brasileiro",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "author": "PloneGov-BR",
  "homepage": "https://github.com/portal-br/legislativo#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:portal-br/legislativo"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "check-ts": "tsc --project tsconfig.json",
    "dry-release": "release-it --dry-run",
    "release": "release-it",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "theme": "@kitconcept/volto-light-theme",
  "addons": [
    "@eeacms/volto-pdf-block",
    "@plone-collective/volto-image-editor",
    "@plonegovbr/volto-vlibras",
    "@plonegovbr/volto-brwidgets",
    "@plone/volto-form-block",
    "@kitconcept/volto-iframe-block",
    "@simplesconsultoria/volto-light-theme"
  ],
  "dependencies": {
    "@eeacms/volto-pdf-block": "1.0.12",
    "@kitconcept/volto-iframe-block": "2.4.1",
    "@plonegovbr/volto-brwidgets": "1.0.0-alpha.3",
    "@plonegovbr/volto-vlibras": "0.4.1",
    "@plone-collective/volto-image-editor": "1.0.1",
    "@plone/components": "workspace:*",
    "@plone/volto-form-block": "1.0.0-alpha.3",
    "@simplesconsultoria/volto-light-theme": "1.0.0-alpha.11"
  },
  "peerDependencies": {
    "@plone/registry": "workspace:*",
    "@plone/types": "workspace:*",
    "classnames": "2.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "3.12.1"
  },
  "devDependencies": {
    "@plone/registry": "workspace:*",
    "@plone/scripts": "workspace:*",
    "@plone/types": "workspace:*",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "@testing-library/react": "^16.2.0",
    "release-it": "^19.0.5",
    "vitest": "^3.1.2"
  }
}
